generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Educator {
  id        String   @id @map("_id")
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  passwordChangedAt DateTime?

  contact    String?
  photoUrl   String?
  profession String?

  notebooks TaskNotebook[]
  tokens    AuthToken[]

  educatorStudents EducatorStudent[]
}

model Student {
  id             String            @id @map("_id")
  name           String
  age            Int
  gender         Gender
  zipcode        String
  road           String
  housenumber    String
  phonenumber    String
  learningTopics String[]
  photoUrl       String?
  documents      StudentDocument[]

  guardianName         String?
  guardianPhone        String?
  guardianRelationship String?

  createdAt      DateTime          @default(now())
  educatorId     String

  educatorStudents EducatorStudent[]

  @@index([educatorId])
}

type StudentDocument {
  id         String
  name       String
  url        String
  uploadedAt DateTime
}

model EducatorStudent {
  id         String @id @map("_id")
  educatorId String
  studentId  String

  educator Educator @relation(fields: [educatorId], references: [id])
  student  Student  @relation(fields: [studentId], references: [id])

  @@index([educatorId])
  @@index([studentId])
}

model Task {
  id           String            @id @map("_id")
  category     TaskCategory
  type         TaskType
  prompt       String
  alternatives TaskAlternative[]
  imageFile    String?
  audioFile    String?
  createdAt    DateTime          @default(now())

  notebookId String?
  notebook   TaskNotebook? @relation(fields: [notebookId], references: [id])

  @@index([notebookId])
}

type TaskAlternative {
  id        String
  text      String
  isCorrect Boolean
}

model TaskNotebook {
  id            String               @id @map("_id")
  educatorId    String
  educator      Educator             @relation(fields: [educatorId], references: [id])
  tasks         Task[]
  category      TaskNotebookCategory
  description   String
  taskGroupsIds String[]
  createdAt     DateTime

  @@index([educatorId])
}

model AuthToken {
  id              String    @id @map("_id")
  token           String?
  tokenHash       String?
  expiresAt       DateTime?
  attempts        Int       @default(0)
  consumedAt      DateTime?
  sendCount       Int       @default(0)
  sendWindowStart DateTime?
  userId          String
  educator        Educator  @relation(fields: [userId], references: [id])

  @@index([userId])
}

enum Gender {
  male
  female
}

enum TaskCategory {
  Reading
  Writing
  Vocabulary
  Comprehension
}

enum TaskType {
  MultipleChoice
  MultipleChoiceWithMedia
}

enum TaskNotebookCategory {
  Reading
  Writing
  Vocabulary
  Comprehension
}

model TaskNotebookSession {
  id             String       @id @map("_id")
  educatorId     String
  studentId      String
  name           String
  startedAt      DateTime
  finishedAt     DateTime?
  observation    String?
  answers        TaskAnswer[]
  taskNotebookId String?
  appointmentId  String?

  @@index([educatorId])
  @@index([studentId])
  // Cron de notificações: sessões finalizadas numa janela, de todos os educadores.
  @@index([finishedAt])
}

model TaskGroup {
  id         String       @id @map("_id")
  name       String
  educatorId String
  taskIds    String[]
  category   TaskCategory

  @@index([educatorId])
}

type TaskAnswer {
  taskId                String
  selectedAlternativeId String
  isCorrect             Boolean
  timeToAnswer          Int // segundos
  answeredAt            DateTime
}

model AnamneseTemplate {
  id          String             @id @map("_id")
  educatorId  String
  title       String
  description String?
  questions   AnamneseQuestion[]
  createdAt   DateTime           @default(now())

  @@index([educatorId])
}

model AnamneseResponse {
  id         String           @id @map("_id")
  templateId String
  educatorId String
  studentId  String
  answeredAt DateTime         @default(now())
  updatedAt  DateTime?
  answers    AnamneseAnswer[]
  summary    AnamneseSummary?

  @@index([templateId])
  @@index([studentId])
}

// Síntese da anamnese gerada por IA (AS-01).
type AnamneseSummary {
  text        String
  generatedAt DateTime
}

type AnamneseQuestionOption {
  id   String
  text String
}

type AnamneseQuestion {
  id       String
  text     String
  type     AnamneseQuestionType
  required Boolean
  order    Int
  options  AnamneseQuestionOption[]
}

type AnamneseAnswer {
  questionId        String
  questionType      AnamneseQuestionType
  textValue         String?
  selectedOptionId  String?
  selectedOptionIds String[]
  fileUrl           String?
}

enum AnamneseQuestionType {
  Descriptive
  MultipleChoice
  Checkbox
  FileUpload
}

model Appointment {
  id          String            @id @map("_id")
  educatorId  String
  studentId   String
  scheduledAt DateTime
  observation String?
  type            String?
  durationMinutes Int?
  status      AppointmentStatus @default(PENDING)
  notifiedAt  DateTime?
  metadata    Json              @default("{}")
  createdAt   DateTime          @default(now())

  // Compostos, não individuais: nenhum caller filtra studentId ou
  // scheduledAt sozinho — sempre junto com educatorId (ListAppointmentsUseCase)
  // ou com status (NotifyAppointmentsUseCase/WatchdogAppointmentsUseCase).
  // MongoDB usa o prefixo do índice composto pra servir a busca só pelo
  // primeiro campo também, então isso cobre educatorId sozinho e
  // status sozinho sem precisar de índices extras.
  @@index([educatorId, studentId])
  @@index([status, scheduledAt])
}

enum AppointmentStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model StudentAnalysisReport {
  id             String                 @id @map("_id")
  studentId      String
  generatedAt    DateTime               @default(now())
  startDate      DateTime?
  endDate        DateTime?
  limit          Int?
  sessionIds     String[]
  categories     CategoryAccuracyData[]
  totalQuestions Int
  totalCorrect   Int
  accuracy       Float

  @@index([studentId])
}

type CategoryAccuracyData {
  category String
  total    Int
  correct  Int
  accuracy Float
}

model Plan {
  id                     String       @id @map("_id")
  educatorId             String
  studentId              String
  type                   PlanType
  status                 PlanStatus
  source                 PlanSource
  title                  String
  generalObjective       String
  professionalNotes      String?
  focus                  String?
  consideredDifficulties String[]
  // Datas sem hora no formato AAAA-MM-DD (fuso America/Sao_Paulo).
  startDate              String
  endDate                String
  nextReviewDate         String?
  parentPlanId           String?
  sessionDate            String?
  appointmentId          String?
  goals                  PlanGoal[]
  createdAt              DateTime
  updatedAt              DateTime
  closedAt               DateTime?

  @@index([educatorId, studentId])
  @@index([studentId, type, status])
  // Cron de notificações: planos ativos com revisão vencendo.
  @@index([status, nextReviewDate])
}

type PlanGoal {
  id               String
  order            Int
  description      String
  successCriterion String?
  status           GoalStatus
  achievedAt       DateTime?
  updatedAt        DateTime
}

model PlanReview {
  id             String                 @id @map("_id")
  planId         String
  educatorId     String
  reviewedAt     DateTime
  note           String
  nextReviewDate String?
  goalStatuses   PlanReviewGoalStatus[]

  @@index([planId])
}

type PlanReviewGoalStatus {
  goalId String
  status GoalStatus
}

enum PlanType {
  PDI
  PE
}

enum PlanStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  ACHIEVED
  DISCONTINUED
}

enum PlanSource {
  AI
  MANUAL
}

model PlanSuggestion {
  id             String               @id @map("_id")
  planId         String
  educatorId     String
  studentId      String
  goalId         String?
  kind           SuggestionKind
  text           String
  proposedChange PlanSuggestionChange
  status         SuggestionStatus
  createdAt      DateTime
  resolvedAt     DateTime?

  @@index([educatorId, status])
  @@index([planId, status])
}

type PlanSuggestionChange {
  status           GoalStatus?
  description      String?
  successCriterion String?
  // AAAA-MM-DD
  nextReviewDate   String?
}

enum SuggestionKind {
  UPDATE_GOAL_STATUS
  ADD_GOAL
  REWRITE_GOAL
  SCHEDULE_REVIEW
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  DISMISSED
}

model SessionEvolution {
  id                    String                @id @map("_id")
  sessionId             String                @unique
  studentId             String
  educatorId            String
  appointmentId         String?
  planId                String?
  planType              String?
  planTitle             String?
  // AAAA-MM-DD: data do início da sessão em America/Sao_Paulo.
  sessionDate           String
  durationMinutes       Int?
  criteria              EvolutionCriterion[]
  descriptiveRecord     String
  nextSessionSuggestion String?
  goalUpdates           EvolutionGoalUpdate[]
  createdAt             DateTime
  updatedAt             DateTime

  @@index([educatorId, studentId])
  @@index([studentId, sessionDate])
}

type EvolutionCriterion {
  id               String
  goalId           String?
  description      String
  successCriterion String?
  attempts         Int?
  successes        Int?
  result           CriterionResult
  note             String?
}

type EvolutionGoalUpdate {
  goalId String
  status GoalStatus
}

enum CriterionResult {
  ACHIEVED
  PARTIAL
  NOT_ACHIEVED
  NOT_OBSERVED
}

// Catálogo de escalas: carregado por seed versionado (scales/*.json) e
// somente leitura para o app. Versão publicada não muda.
model ScaleTemplate {
  id               String          @id @map("_id")
  code             String
  version          Int
  name             String
  description      String
  instructions     String
  respondent       ScaleRespondent
  ageRange         ScaleAgeRange?
  estimatedMinutes Int
  options          ScaleOption[]
  items            ScaleItem[]
  subscales        ScaleSubscale[]
  scoring          ScaleScoring
  disclaimer       String
  reference        String
  active           Boolean

  @@unique([code, version])
}

type ScaleAgeRange {
  min Int
  max Int
}

type ScaleOption {
  value Float
  label String
}

type ScaleItem {
  id           String
  order        Int
  text         String
  subscaleCode String?
}

type ScaleSubscale {
  code String
  name String
}

type ScaleScoring {
  method ScoringMethod
  bands  ScaleBand[]
}

type ScaleBand {
  subscaleCode String?
  min          Float
  max          Float
  label        String
  severity     BandSeverity
}

enum ScaleRespondent {
  PROFESSIONAL
  GUARDIAN
  TEACHER
}

enum BandSeverity {
  LOW
  MODERATE
  HIGH
}

enum ScoringMethod {
  SUM
  MEAN
}

// O escore não é gravado: é recalculado com o template da versão gravada.
model ScaleApplication {
  id              String            @id @map("_id")
  templateId      String
  templateCode    String
  templateVersion Int
  templateName    String
  studentId       String
  educatorId      String
  appointmentId   String?
  status          ApplicationStatus
  answers         ScaleAnswer[]
  insight         ScaleInsight?
  startedAt       DateTime
  updatedAt       DateTime
  completedAt     DateTime?

  @@index([studentId, status, updatedAt])
  @@index([studentId, templateCode, status])
  // Cron de notificações: rascunhos parados de todos os educadores.
  @@index([status, updatedAt])
}

type ScaleAnswer {
  itemId String
  value  Float
}

type ScaleInsight {
  text        String
  generatedAt DateTime
  preliminary Boolean
}

enum ApplicationStatus {
  DRAFT
  COMPLETED
}

model Report {
  id              String         @id @map("_id")
  studentId       String
  // Nome do aluno na geração, para o histórico.
  studentName     String
  educatorId      String
  type            ReportType
  audience        ReportAudience
  // AAAA-MM-DD, inclusivos.
  periodFrom      String
  periodTo        String
  sections        String[]
  // Retrato congelado na geração (RP-03); não muda depois.
  content         Json
  synthesisFailed Boolean        @default(false)
  shares          ReportShare[]
  createdAt       DateTime

  // A listagem filtra pelos alunos do dono atual, mais recentes primeiro.
  @@index([studentId, createdAt])
}

type ReportShare {
  channel ReportShareChannel
  at      DateTime
}

enum ReportType {
  PROGRESS
  ASSESSMENT
  PDI_PROGRESS
}

enum ReportAudience {
  FAMILY
  SCHOOL
  PROFESSIONAL
}

enum ReportShareChannel {
  SHARE
  PRINT
}

model Notification {
  id         String                  @id @map("_id")
  educatorId String
  kind       NotificationKind
  title      String
  body       String
  targetType NotificationTargetType?
  targetId   String?
  // Aluno da notificação: some da lista se ele deixar de ser do educador.
  studentId  String?
  // Uma por kind + alvo + dia; o cron pode rodar de novo sem duplicar.
  dedupeKey  String                  @unique
  createdAt  DateTime
  readAt     DateTime?

  // Lista paginada do educador, mais recentes primeiro.
  @@index([educatorId, createdAt])
  // Retenção: o cron apaga as mais antigas que 90 dias.
  @@index([createdAt])
}

enum NotificationKind {
  APPOINTMENTS_TODAY
  EVOLUTION_PENDING
  PLAN_REVIEW_DUE
  SCALE_DRAFT_STALE
}

enum NotificationTargetType {
  AGENDA_DAY
  SESSION
  PLAN
  SCALE_APPLICATION
}
